# Firefly Cove configuration — copy to ".env" or export in your shell.

# REQUIRED: your free Presage Physiology API key.
# Register at https://physiology.presagetech.com/auth/register , confirm your
# email, log in, and copy the API key from the developer portal.
SMARTSPECTRA_API_KEY=

# Optional: HTTP port for the local web experience (default 4399).
PORT=4399

# Optional: input source — "camera" (default) or "file".
SOURCE=camera

# Only used when SOURCE=file: path to a pre-recorded face video (mp4/mov).
# Useful for recording the demo or for judges to test without a camera.
VIDEO_PATH=
